# Rust build artifacts (workspace root + any stray per-crate target dirs)
/target
**/target/

# Generated manifest — regenerated from Cargo.toml.in by prepare-build.sh
/Cargo.toml
/candidate-worker/Cargo.toml

# Generated by prepare-build.sh (cargo vendor snapshot + source-replacement config)
/.cargo/config.toml
/.cargo/vendor-source.toml
/vendor/

# Harness output — regenerated every run, would create noise/conflicts
score.json

# Per-machine coding-agent scratch state — local only, never published. Nothing
# under these directories is part of the harness or the contract.
.claude/
.superpowers/

# Editor / OS noise
*.swp
.DS_Store
.idea/
.vscode/
