//! Standalone micro-benchmark of the worker protocol's per-row I/O price.
//! Links the REAL `ssi_worker_protocol` crate from the workspace target dir, so
//! what it times is exactly what `ssi-candidate-worker` runs inside the 2 s cap.
use std::time::Instant;
use ssi_worker_protocol::{read_pattern, read_permutation, write_pattern, write_permutation};
use ssi_scoring::Pattern;

fn synth(n: usize, per_col: usize) -> Pattern {
    let mut col_ptr = Vec::with_capacity(n + 1);
    col_ptr.push(0);
    let mut acc = 0usize;
    for _ in 0..n {
        acc += per_col;
        col_ptr.push(acc);
    }
    let row_idx: Vec<usize> = (0..acc).map(|i| i % n).collect();
    Pattern { n, col_ptr, row_idx }
}

fn main() {
    // (n, nnz) points around the dev corpus maximum and beyond it.
    for &(n, nnz) in &[
        (272_878usize, 1_379_706usize), // faclay75: dev's densest row
        (313_068, 1_292_408),           // acopf_case9241pegase_qcqp: dev's widest row
        (500_000, 3_000_000),           // 2.2x dev's biggest
        (1_000_000, 6_000_000),         // 4.3x dev's biggest
    ] {
        let per = (nnz + n - 1) / n;
        let pat = synth(n, per);
        let nnz_real = pat.row_idx.len();
        let path = format!("/tmp/io_bench_{n}.bin");
        let perm_path = format!("/tmp/io_bench_perm_{n}.bin");

        let t = Instant::now();
        write_pattern(std::path::Path::new(&path), &pat).unwrap();
        let w = t.elapsed().as_secs_f64();

        // warm read (page cache), repeated: the worker's own cost shape
        let mut reads = Vec::new();
        for _ in 0..5 {
            let t = Instant::now();
            let p = read_pattern(std::path::Path::new(&path)).unwrap();
            reads.push(t.elapsed().as_secs_f64());
            std::hint::black_box(p.col_ptr.len() + p.row_idx.len());
        }
        let rmin = reads.iter().cloned().fold(f64::MAX, f64::min);

        let perm: Vec<usize> = (0..n).collect();
        let t = Instant::now();
        write_permutation(std::path::Path::new(&perm_path), &perm).unwrap();
        let wp = t.elapsed().as_secs_f64();
        let t = Instant::now();
        let back = read_permutation(std::path::Path::new(&perm_path), n).unwrap();
        let rp = t.elapsed().as_secs_f64();
        assert_eq!(back.len(), n);

        let bytes = 8.0 * (n + 1) as f64 + 8.0 * nnz_real as f64 + 16.0;
        println!(
            "n={n:>8} nnz={nnz_real:>9} file={:.1}MB | write_pattern={w:.4}s read_pattern={rmin:.4}s \
             write_perm={wp:.4}s read_perm={rp:.4}s | worker-io={:.4}s",
            bytes / 1e6,
            rmin + wp
        );
    }
}
